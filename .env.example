APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_SECRET=replace-with-the-same-value-as-OTP_SECRET-in-apps-script
AUTH_SECRET=replace-with-a-long-random-string

# Capacitor / USB testing: where the Android WebView should send OTP requests.
# Leave empty for browser `pnpm dev`. For a phone on USB, use your Mac LAN IP, e.g. http://192.168.1.8:3000
NEXT_PUBLIC_AUTH_API_ORIGIN=
AUTH_CORS_ORIGIN=*
